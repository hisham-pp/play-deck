# Supabase Configuration (Latest format)
# Get these from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy fallback (optional, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY takes precedence)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Voice Chat (optional)
# Voice works over public STUN by default. Symmetric NATs and strict corporate
# networks need a TURN relay to connect; supply one here to cover those players.
# NEXT_PUBLIC_VOICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# NEXT_PUBLIC_VOICE_TURN_URL=turn:your-relay.example.com:3478
# NEXT_PUBLIC_VOICE_TURN_USERNAME=your-turn-username
# NEXT_PUBLIC_VOICE_TURN_CREDENTIAL=your-turn-credential
